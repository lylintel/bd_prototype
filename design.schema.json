{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BD Studio design v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "ports", "instances", "nets"],
  "properties": {
    "schema_version": {"const": 2, "type": "integer"},
    "name": {"type": "string", "maxLength": 256},
    "project_ips": {"type": "array", "maxItems": 200, "items": {"type": "object"}},
    "ports": {"type": "object", "maxProperties": 20000, "additionalProperties": {"$ref": "#/$defs/port"}},
    "instances": {"type": "array", "maxItems": 20000, "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "ip"],
      "properties": {
        "name": {"type": "string", "maxLength": 256},
        "ip": {"type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": {"id": {"type": "string", "maxLength": 256}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])"}}},
        "params": {"type": "object", "additionalProperties": {"$ref": "#/$defs/integerExpression"}}
      }
    }},
    "nets": {"type": "array", "maxItems": 100000, "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "endpoints"],
      "properties": {"name": {"type": "string", "maxLength": 256}, "endpoints": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/endpoint"}}}
    }}
  },
  "$defs": {
    "integerExpression": {"oneOf": [{"type": "integer", "minimum": -2147483648, "maximum": 2147483647}, {"type": "string", "minLength": 1, "maxLength": 4096}]},
    "port": {"type": "object", "additionalProperties": false, "required": ["direction"], "properties": {
      "direction": {"enum": ["input", "output"]}, "signed": {"type": "boolean"},
      "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/integerExpression"}}
    }},
    "endpoint": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["inst", "port"], "properties": {"inst": {"type": "string"}, "port": {"type": "string"}}},
      {"type": "object", "additionalProperties": false, "required": ["ext"], "properties": {"ext": {"type": "string"}}}
    ]}
  }
}